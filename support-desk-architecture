## 2. Модель данных (PostgreSQL)

```sql
-- Клиенты, подтягиваются синком из Oracle
CREATE TABLE clients (
  id            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  name          TEXT NOT NULL,
  tg_group_id   BIGINT NOT NULL UNIQUE,
  chat_label    TEXT,                 -- короткое имя чата для UI
  active        BOOLEAN NOT NULL DEFAULT TRUE,
  created_at    TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- Сырые сообщения из чатов (для истории/аудита и переанализа)
CREATE TABLE messages (
  id            BIGSERIAL PRIMARY KEY,
  client_id     UUID NOT NULL REFERENCES clients(id),
  tg_message_id BIGINT NOT NULL,
  sender_type   TEXT NOT NULL CHECK (sender_type IN ('client','agent')),
  sender_name   TEXT,
  text          TEXT NOT NULL,
  sent_at       TIMESTAMPTZ NOT NULL,
  ticket_id     BIGINT REFERENCES tickets(id)
);

-- Обращения
CREATE TABLE tickets (
  id                BIGSERIAL PRIMARY KEY,
  code              TEXT UNIQUE NOT NULL,         -- SUP-1042
  client_id         UUID NOT NULL REFERENCES clients(id),
  category          TEXT NOT NULL,                -- ставит LLM
  status            TEXT NOT NULL DEFAULT 'open'
                     CHECK (status IN ('open','pending_confirm','closed')),
  subject           TEXT NOT NULL,                -- краткое описание от LLM
  first_message_at  TIMESTAMPTZ NOT NULL,
  first_response_at TIMESTAMPTZ,
  closed_at         TIMESTAMPTZ,
  ai_confidence     SMALLINT,                     -- уверенность LLM, 0-100
  promise_text      TEXT,                         -- что пообещали клиенту
  jira_url          TEXT,
  due_date          DATE,
  created_at        TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE INDEX ON tickets (client_id, first_message_at);
CREATE INDEX ON tickets (status);

-- Дневные сводки
CREATE TABLE daily_summaries (
  id            BIGSERIAL PRIMARY KEY,
  summary_date  DATE NOT NULL UNIQUE,
  summary_text  TEXT NOT NULL,
  model_used    TEXT NOT NULL,
  generated_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
  sent_at       TIMESTAMPTZ
);

-- Настройки ИИ и SLA-порогов (одна активная строка, либо key-value)
CREATE TABLE settings (
  key           TEXT PRIMARY KEY,
  value         JSONB NOT NULL
  -- ключи: ai_provider, ai_model, ai_api_key (шифрованный),
  -- target_first_response_min, attention_after_min, auto_confidence_pct,
  -- toggles: auto_close, auto_promise, daily_digest, remind_before_due
);
```

Метрики за период (7/30/90 дней, произвольный диапазон) и «среднее в месяц
по темам» на клиента — это обычные агрегирующие запросы `WHERE
first_message_at BETWEEN ... GROUP BY category`. Материализация в отдельную
таблицу не нужна, пока объём не вырастет настолько, что агрегаты станут
дорогими on the fly.

